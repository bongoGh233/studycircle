# Supabase project credentials — Phase 2
# Copy this file to `.env.local` and fill in the values from:
#   Supabase dashboard → Project Settings → API
#
# Use the Project URL and the anon/public key ONLY.
# Never put a service-role key in this file or anywhere in the frontend:
# it bypasses Row Level Security.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
